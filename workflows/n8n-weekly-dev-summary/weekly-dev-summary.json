        "url": "={{$json.webhookUrl}}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"content\":\"={{$json.content}}\"}",
        "options": {}
      },
      "id": "9ca15ab1-d8f3-4b2f-9d62-4df534a71bb9",
      "name": "Send Discord Webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1920,
        0
      ]
    }
